# Copie para .env (o arquivo .env nunca vai para o GitHub).

# Endereço do PostgreSQL. Deixe vazio no seu computador para usar o banco
# embutido (salvo na pasta ./data). No Render, ele é preenchido automaticamente.
DATABASE_URL=

# Segredo usado para assinar as sessões de login. Use um texto longo e aleatório.
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Porta do servidor (o Render define sozinho).
PORT=3000

# SSL do banco: auto (padrão), true ou false.
DATABASE_SSL=auto
